{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cropx/faq-accordion",
  "version": "0.1.0",
  "title": "FAQ Accordion",
  "category": "cropx",
  "icon": "editor-help",
  "description": "Single-open accordion with smooth height animation. Optional centered eyebrow + heading above the list. Each item: question (button) + answer panel with aria-expanded / aria-controls wiring.",
  "keywords": [ "faq", "accordion", "questions", "answers" ],
  "supports": {
    "html": false,
    "align": false
  },
  "attributes": {
    "showHeader": { "type": "boolean", "default": true },
    "eyebrow":    { "type": "string",  "default": "" },
    "heading":    { "type": "string",  "default": "" },
    "items": {
      "type": "array",
      "default": [
        { "question": "", "answer": "" },
        { "question": "", "answer": "" },
        { "question": "", "answer": "" }
      ]
    },
    "eyebrowColor": { "type": "string",  "default": "cropx-blue" }
  },
  "editorScript": "file:./index.js",
  "editorStyle":  "file:./index.css",
  "style":        "file:./style-index.css",
  "viewScript":   "file:./view.js",
  "render":       "file:./render.php"
}
