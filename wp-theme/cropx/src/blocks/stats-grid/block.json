{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cropx/stats-grid",
	"title": "Text with Stats Grid",
	"category": "cropx-text-only",
	"icon": "chart-bar",
	"description": "Left column with eyebrow, heading, body, and CTA alongside a 2-8 stat grid of large stat numbers with segment-accent left borders.",
	"keywords": [
		"stats",
		"metrics",
		"numbers",
		"grid"
	],
	"textdomain": "cropx",
	"supports": {
		"html": false,
		"align": false,
		"anchor": true
	},
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": "By the numbers"
		},
		"heading": {
			"type": "string",
			"default": "Real impact, measurable results"
		},
		"body": {
			"type": "string",
			"default": "CropX-managed acres consistently outperform conventional approaches. Here's what our customers achieve when soil intelligence drives every decision."
		},
		"ctaLabel": {
			"type": "string",
			"default": "Read more"
		},
		"ctaUrl": {
			"type": "string",
			"default": "#"
		},
		"segmentAccent": {
			"type": "string",
			"default": "general",
			"enum": [
				"general",
				"enterprise",
				"service-provider",
				"on-farm"
			]
		},
		"stat1Number": {
			"type": "string",
			"default": "30%"
		},
		"stat1Descriptor": {
			"type": "string",
			"default": "Average water savings across monitored fields."
		},
		"stat2Number": {
			"type": "string",
			"default": "3M+"
		},
		"stat2Descriptor": {
			"type": "string",
			"default": "Acres of fields actively managed on the CropX platform."
		},
		"stat3Number": {
			"type": "string",
			"default": "14%"
		},
		"stat3Descriptor": {
			"type": "string",
			"default": "Higher yields reported by growers on CropX-managed acres."
		},
		"stat4Number": {
			"type": "string",
			"default": "200+"
		},
		"stat4Descriptor": {
			"type": "string",
			"default": "Crop types supported with custom-calibrated models."
		},
		"stat5Number": {
			"type": "string",
			"default": ""
		},
		"stat5Descriptor": {
			"type": "string",
			"default": ""
		},
		"stat6Number": {
			"type": "string",
			"default": ""
		},
		"stat6Descriptor": {
			"type": "string",
			"default": ""
		},
		"stat7Number": {
			"type": "string",
			"default": ""
		},
		"stat7Descriptor": {
			"type": "string",
			"default": ""
		},
		"stat8Number": {
			"type": "string",
			"default": ""
		},
		"stat8Descriptor": {
			"type": "string",
			"default": ""
		},
		"statCount": {
			"type": "number",
			"default": 4
		},
		"stat1FontSize": {
			"type": "string",
			"default": "5rem",
			"enum": [ "3rem", "4rem", "5rem", "6rem" ]
		},
		"stat2FontSize": {
			"type": "string",
			"default": "5rem",
			"enum": [ "3rem", "4rem", "5rem", "6rem" ]
		},
		"stat3FontSize": {
			"type": "string",
			"default": "5rem",
			"enum": [ "3rem", "4rem", "5rem", "6rem" ]
		},
		"stat4FontSize": {
			"type": "string",
			"default": "5rem",
			"enum": [ "3rem", "4rem", "5rem", "6rem" ]
		},
		"stat5FontSize": {
			"type": "string",
			"default": "5rem",
			"enum": [ "3rem", "4rem", "5rem", "6rem" ]
		},
		"stat6FontSize": {
			"type": "string",
			"default": "5rem",
			"enum": [ "3rem", "4rem", "5rem", "6rem" ]
		},
		"stat7FontSize": {
			"type": "string",
			"default": "5rem",
			"enum": [ "3rem", "4rem", "5rem", "6rem" ]
		},
		"stat8FontSize": {
			"type": "string",
			"default": "5rem",
			"enum": [ "3rem", "4rem", "5rem", "6rem" ]
		},
		"showIcons": {
			"type": "boolean",
			"default": false
		},
		"showBorder": {
			"type": "boolean",
			"default": true
		},
		"stat1Icon": {
			"type": "string",
			"default": "chart"
		},
		"stat2Icon": {
			"type": "string",
			"default": "chart"
		},
		"stat3Icon": {
			"type": "string",
			"default": "chart"
		},
		"stat4Icon": {
			"type": "string",
			"default": "chart"
		},
		"stat5Icon": {
			"type": "string",
			"default": "chart"
		},
		"stat6Icon": {
			"type": "string",
			"default": "chart"
		},
		"stat7Icon": {
			"type": "string",
			"default": "chart"
		},
		"stat8Icon": {
			"type": "string",
			"default": "chart"
		},
		"eyebrowColor": {
			"type": "string",
			"default": "cropx-blue"
		},
		"ctaStyle": {
			"type": "string",
			"default": "link"
		},
		"showEyebrow": {
			"type": "boolean",
			"default": true
		},
		"showCta": {
			"type": "boolean",
			"default": true
		},
		"bgColor": {
			"type": "string",
			"default": "white",
			"enum": [
				"taupe",
				"white",
				"deep-blue"
			]
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
