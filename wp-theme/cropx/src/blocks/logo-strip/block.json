{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cropx/logo-strip",
  "version": "0.1.0",
  "title": "Logo Strip",
  "category": "cropx",
  "icon": "images-alt2",
  "description": "Full-width scrolling marquee of customer logos with an eyebrow label. Logos are hardcoded; only the eyebrow text is editable.",
  "keywords": ["logos", "customers", "marquee", "trust"],
  "supports": {
    "html": false,
    "align": false,
    "anchor": true
  },
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "Trusted by leading brands worldwide"
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
