{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cropx/product-tabs",
  "title": "Product Tabs – ARCHIVED",
  "category": "cropx-product",
  "icon": "grid-view",
  "description": "Two-tab product grid (CropX Platform / CropX Hardware) with section header, sticky tab strip, and horizontal pg-style cards.",
  "keywords": ["products", "tabs", "hardware", "platform", "software", "grid"],
  "supports": {
    "html": false,
    "align": false,
    "anchor": true,
    "inserter": false
  },
  "attributes": {
    "platformLabel":  { "type": "string", "default": "CropX Platform" },
    "hardwareLabel":  { "type": "string", "default": "CropX Hardware" },

    "platformEyebrow": { "type": "string", "default": "Software" },
    "platformHeading": { "type": "string", "default": "Intelligence and decision-support for every layer of your operation" },
    "platformBlurb":   { "type": "string", "default": "" },

    "hardwareEyebrow": { "type": "string", "default": "Sensors & Devices" },
    "hardwareHeading": { "type": "string", "default": "The sensors, stations, and gateways behind your farm data" },
    "hardwareBlurb":   { "type": "string", "default": "" },

    "bgColor": { "type": "string", "default": "white", "enum": ["taupe", "white"] },

    "platformItems": {
      "type": "array",
      "default": [
        {
          "name": "Farm Management", "description": "End-to-end planning and irrigation scheduling on one platform.", "url": "#",
          "photoId": 0, "photoUrl": "", "photoAlt": "",
          "photoFocalX": 0.5, "photoFocalY": 0.5, "photoZoom": 100,
          "overlayId": 0, "overlayUrl": "", "overlayType": "none", "overlayPadding": 0,
          "overlayH": 100, "overlayX": 0, "overlayCentered": false, "overlayAnchor": "center"
        }
      ]
    },
    "hardwareItems": {
      "type": "array",
      "default": [
        {
          "name": "CropX Vertex 4", "description": "All-in-one smart soil sensor. Monitors moisture, temperature, and salinity at multiple depths.", "url": "#",
          "photoId": 0, "photoUrl": "", "photoAlt": "",
          "photoFocalX": 0.5, "photoFocalY": 0.5, "photoZoom": 100,
          "overlayId": 0, "overlayUrl": "", "overlayType": "none", "overlayPadding": 0,
          "overlayH": 100, "overlayX": 0, "overlayCentered": false, "overlayAnchor": "center"
        }
      ]
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle":  "file:./index.css",
  "style":        "file:./style-index.css",
  "viewScript":   "file:./view.js",
  "render":       "file:./render.php"
}
