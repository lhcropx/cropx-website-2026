{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cropx/feature-stat",
	"version": "0.1.0",
	"title": "2-Column Layout with Photo & Stat Card",
	"category": "cropx",
	"icon": "image-filter",
	"description": "Two-column feature section with photo and overlaid stat card. 4 variants: photo right/left × white/Deep Blue backgrounds.",
	"keywords": [ "feature", "stat", "photo", "card" ],
	"textdomain": "cropx",
	"supports": {
		"html": false,
		"align": false,
		"anchor": true
	},
	"attributes": {
		"photoPosition":     { "type": "string",  "default": "right",         "enum": [ "right", "left" ] },
		"backgroundVariant": { "type": "string",  "default": "white",         "enum": [ "white", "blue" ] },
		"segmentAccent":     { "type": "string",  "default": "general",       "enum": [ "general", "enterprise", "service-provider", "on-farm" ] },
		"icon":              { "type": "string",  "default": "sensor-cloud" },
		"eyebrow":           { "type": "string",  "default": "Soil Intelligence" },
		"heading":           { "type": "string",  "default": "Real-time data from every corner of your field" },
		"body":              { "type": "string",  "default": "CropX sensors capture soil moisture, temperature, and salinity at multiple depths — giving you a complete picture of what's happening underground, updated continuously throughout the day." },
		"ctaLabel":          { "type": "string",  "default": "" },
		"ctaUrl":            { "type": "string",  "default": "#" },
		"photoId":           { "type": "integer", "default": 0 },
		"photoUrl":          { "type": "string",  "default": "" },
		"photoAlt":          { "type": "string",  "default": "" },
		"cardContext":        { "type": "string",  "default": "Growers using CropX reduced water use by" },
		"cardNumber":        { "type": "string",  "default": "30%" },
		"cardMetric":        { "type": "string",  "default": "average water savings across monitored fields" },
		"eyebrowColor":      { "type": "string",  "default": "cropx-blue" },
		"ctaStyle":          { "type": "string",  "default": "link" },
		"showIcon":          { "type": "boolean", "default": true },
		"showEyebrow":       { "type": "boolean", "default": true },
		"showCta":           { "type": "boolean", "default": true }
	},
	"editorScript": "file:./index.js",
	"editorStyle":  "file:./index.css",
	"style":        "file:./style-index.css",
	"render":       "file:./render.php"
}
