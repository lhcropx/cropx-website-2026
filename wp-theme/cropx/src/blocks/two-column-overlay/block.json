{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cropx/two-column-overlay",
  "version": "0.1.0",
  "title": "Two-Column + Overlay",
  "category": "cropx",
  "icon": "format-image",
  "description": "Two-column layout: rich-text content left or right, photo with a floating overlay PNG on the opposite side. 6 variants via photoPosition × overlayPosition.",
  "keywords": [ "two-column", "overlay", "photo", "png", "feature" ],
  "supports": {
    "html": false,
    "align": false
  },
  "attributes": {
    "photoPosition":   { "type": "string", "default": "right"   },
    "overlayPosition": { "type": "string", "default": "center"  },
    "segmentAccent":   { "type": "string", "default": "general" },
    "icon":            { "type": "string", "default": "fields"  },
    "eyebrow":         { "type": "string", "default": ""        },
    "heading":         { "type": "string", "default": ""        },
    "body":            { "type": "string", "default": ""        },
    "ctaLabel":        { "type": "string", "default": ""        },
    "ctaUrl":          { "type": "string", "default": "#"       },
    "photoId":         { "type": "number", "default": 0         },
    "photoUrl":        { "type": "string", "default": ""        },
    "photoAlt":        { "type": "string", "default": ""        },
    "overlayId":       { "type": "number", "default": 0         },
    "overlayUrl":      { "type": "string", "default": ""        },
    "overlayAlt":      { "type": "string", "default": ""        },
    "overlayAnchor":   { "type": "number", "default": 25        },
    "bleedX":          { "type": "number", "default": 4         },
    "eyebrowColor":    { "type": "string", "default": "cropx-blue" },
    "ctaStyle":        { "type": "string", "default": "button" }
  },
  "editorScript": "file:./index.js",
  "editorStyle":  "file:./index.css",
  "style":        "file:./style-index.css",
  "render":       "file:./render.php"
}
