{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cropx/two-column-overlay",
  "title": "2 Columns with Text & Product Illustration",
  "category": "cropx-text-visual",
  "icon": "format-image",
  "description": "Two-column layout: rich-text content left or right, photo with a floating overlay PNG that hangs 40px off one of 8 fixed edge/corner positions.",
  "keywords": [
    "two-column",
    "overlay",
    "photo",
    "png",
    "feature"
  ],
  "supports": {
    "html": false,
    "align": false
  },
  "attributes": {
    "photoPosition": {
      "type": "string",
      "default": "right"
    },
    "segmentAccent": {
      "type": "string",
      "default": "general"
    },
    "icon": {
      "type": "string",
      "default": "fields"
    },
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "body": {
      "type": "string",
      "default": ""
    },
    "ctaLabel": {
      "type": "string",
      "default": ""
    },
    "ctaUrl": {
      "type": "string",
      "default": "#"
    },
    "photoId": {
      "type": "number",
      "default": 0
    },
    "photoUrl": {
      "type": "string",
      "default": ""
    },
    "photoAlt": {
      "type": "string",
      "default": ""
    },
    "photoFocalX": {
      "type": "number",
      "default": 0.5
    },
    "photoFocalY": {
      "type": "number",
      "default": 0.5
    },
    "photoZoom": {
      "type": "number",
      "default": 100
    },
    "overlayId": {
      "type": "number",
      "default": 0
    },
    "overlayUrl": {
      "type": "string",
      "default": ""
    },
    "overlayAlt": {
      "type": "string",
      "default": ""
    },
    "overlayWidth": {
      "type": "number",
      "default": 0
    },
    "overlayHeight": {
      "type": "number",
      "default": 0
    },
    "overlayScale": {
      "type": "number",
      "default": 75
    },
    "overlayPosition": {
      "type": "string",
      "default": "left",
      "enum": [
        "left",
        "right",
        "top",
        "bottom",
        "top-left",
        "top-right",
        "bottom-left",
        "bottom-right"
      ]
    },
    "overlayFullBleed": {
      "type": "boolean",
      "default": false
    },
    "overlayCornerRadius": {
      "type": "number",
      "default": 10
    },
    "eyebrowColor": {
      "type": "string",
      "default": "cropx-blue"
    },
    "ctaStyle": {
      "type": "string",
      "default": "button"
    },
    "showIcon": {
      "type": "boolean",
      "default": true
    },
    "showEyebrow": {
      "type": "boolean",
      "default": true
    },
    "showCta": {
      "type": "boolean",
      "default": true
    },
    "bgColor": {
      "type": "string",
      "default": "white",
      "enum": [
        "taupe",
        "white",
        "deep-blue"
      ]
    },
    "mobileStack": {
      "type": "string",
      "default": "visual-first",
      "enum": [ "visual-first", "text-first" ]
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
