{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cropx/segments",
  "title": "3-Column Segment Navigation",
  "category": "cropx-global",
  "icon": "layout",
  "description": "Three photo-panel audience segment block (Enterprise / Service Providers / On-Farm). Deep Blue background. Desktop: 3-column photo panels. Mobile: WAI-ARIA tabbed interface.",
  "keywords": [ "segments", "enterprise", "service provider", "on-farm", "audience" ],
  "supports": {
    "html": false,
    "align": false,
    "anchor": true
  },
  "attributes": {
    "sectionEyebrow":    { "type": "string",  "default": "Who we serve" },
    "sectionHeading":    { "type": "string",  "default": "Solutions built for every part of agriculture" },
    "showSectionHeader":  { "type": "boolean", "default": true },
    "showSectionEyebrow": { "type": "boolean", "default": true },

    "enterpriseEyebrow":  { "type": "string",  "default": "Enterprise" },
    "enterpriseHeading":  { "type": "string",  "default": "Enterprise Solutions" },
    "enterpriseBody":     { "type": "string",  "default": "Get real-time visibility into field conditions across hundreds of farms — enabling smarter procurement decisions, EUDR compliance, and measurable sustainability outcomes at scale." },
    "enterpriseUrl":      { "type": "string",  "default": "#" },
    "enterprisePhotoUrl": { "type": "string",  "default": "" },
    "enterprisePhotoId":  { "type": "integer", "default": 0 },

    "serviceEyebrow":     { "type": "string",  "default": "Service Providers" },
    "serviceHeading":     { "type": "string",  "default": "Service Providers" },
    "serviceBody":        { "type": "string",  "default": "See precision soil and climate data across every client farm — so you can spend less time on manual reporting and more time on insights that drive outcomes for your growers." },
    "serviceUrl":         { "type": "string",  "default": "#" },
    "servicePhotoUrl":    { "type": "string",  "default": "" },
    "servicePhotoId":     { "type": "integer", "default": 0 },

    "onFarmEyebrow":      { "type": "string",  "default": "On-Farm" },
    "onFarmHeading":      { "type": "string",  "default": "On-Farm Solutions" },
    "onFarmBody":         { "type": "string",  "default": "From irrigation scheduling to soil health monitoring — real-time data so you can cut input costs and improve yields season after season." },
    "onFarmUrl":          { "type": "string",  "default": "#" },
    "onFarmPhotoUrl":     { "type": "string",  "default": "" },
    "onFarmPhotoId":      { "type": "integer", "default": 0 },

    "showEyebrow":  { "type": "boolean", "default": true },
    "segmentOrder": { "type": "array",   "default": ["enterprise", "service", "onFarm"] }
  },
  "editorScript": "file:./index.js",
  "editorStyle":  "file:./index.css",
  "style":        "file:./style-index.css",
  "viewScript":   "file:./view.js",
  "render":       "file:./render.php"
}
