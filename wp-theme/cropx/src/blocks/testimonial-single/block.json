{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cropx/testimonial-single",
  "title": "Single Full-Width Testimonial",
  "category": "cropx-social-proof",
  "icon": "format-quote",
  "description": "Big-quote spotlight. Centered quote with curly-quote pseudo-elements, attribution row (3.5rem square photo or logo + name + title/company). Three background variants: taupe, white, and Deep Blue with animated drift pattern. Content source: manual (type directly), pick (choose one Quote CPT post), or auto (newest Quote in an optional category) — same three-mode system as Testimonial Carousel.",
  "keywords": [ "testimonial", "quote", "customer", "review" ],
  "supports": {
    "html": false,
    "align": false
  },
  "attributes": {
    "backgroundVariant": { "type": "string",  "default": "blue", "enum": ["taupe", "white", "blue"] },
    "contentSource":     { "type": "string",  "default": "manual", "enum": ["manual", "pick", "auto"] },
    "quote":             { "type": "string",  "default": "" },
    "authorName":        { "type": "string",  "default": "" },
    "authorTitle":       { "type": "string",  "default": "" },
    "authorCompany":     { "type": "string",  "default": "" },
    "showPhoto":         { "type": "boolean", "default": true },
    "photoId":           { "type": "number",  "default": 0  },
    "photoUrl":          { "type": "string",  "default": "" },
    "photoAlt":          { "type": "string",  "default": "" },
    "testimonialId":     { "type": "number",  "default": 0  },
    "testimonialCategory": { "type": "string", "default": "" }
  },
  "editorScript": "file:./index.js",
  "editorStyle":  "file:./index.css",
  "style":        "file:./style-index.css",
  "render":       "file:./render.php"
}
