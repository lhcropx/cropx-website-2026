{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cropx/cards-carousel",
  "title": "Content Card Carousel",
  "category": "cropx-content",
  "icon": "slides",
  "description": "Wide, horizontal-scroll carousel of content cards — photo on the left, title/excerpt/CTA on the right. Same content-sourcing engine as the 3-Column Content Cards block (manual cards, choose posts, or auto-query a single/mixed source), just laid out one wide card at a time instead of a grid. Optional stat/number badge overlay on the photo (manual + Choose Posts modes only) and an optional auto-advance toggle.",
  "keywords": [
    "cards",
    "carousel",
    "slider",
    "case studies",
    "content"
  ],
  "supports": {
    "html": false,
    "align": false,
    "anchor": true
  },
  "attributes": {
    "cardVariant": {
      "type": "string",
      "default": "white"
    },
    "showHeader": {
      "type": "boolean",
      "default": true
    },
    "showEyebrow": {
      "type": "boolean",
      "default": true
    },
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "eyebrowColor": {
      "type": "string",
      "default": "cropx-blue"
    },
    "autoAdvance": {
      "type": "boolean",
      "default": false
    },
    "cards": {
      "type": "array",
      "default": [
        {
          "photoId": 0,
          "photoUrl": "",
          "photoAlt": "",
          "tag": "",
          "tagUrl": "#",
          "date": "",
          "title": "",
          "excerpt": "",
          "ctaLabel": "Read more",
          "ctaUrl": "#",
          "statValue": "",
          "statLabel": ""
        },
        {
          "photoId": 0,
          "photoUrl": "",
          "photoAlt": "",
          "tag": "",
          "tagUrl": "#",
          "date": "",
          "title": "",
          "excerpt": "",
          "ctaLabel": "Read more",
          "ctaUrl": "#",
          "statValue": "",
          "statLabel": ""
        },
        {
          "photoId": 0,
          "photoUrl": "",
          "photoAlt": "",
          "tag": "",
          "tagUrl": "#",
          "date": "",
          "title": "",
          "excerpt": "",
          "ctaLabel": "Read more",
          "ctaUrl": "#",
          "statValue": "",
          "statLabel": ""
        }
      ]
    },
    "queryMode": {
      "type": "string",
      "default": "manual"
    },
    "queryPostType": {
      "type": "string",
      "default": "cropx_publication"
    },
    "queryLimit": {
      "type": "integer",
      "default": 3
    },
    "queryContentTypes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "queryCategories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "queryAutoType": {
      "type": "string",
      "default": "single",
      "enum": [
        "single",
        "mixed"
      ]
    },
    "queryRules": {
      "type": "array",
      "default": [
        {
          "postType": "cropx_publication",
          "contentTypes": [],
          "categories": [],
          "limit": 1
        }
      ]
    },
    "excerptLines": {
      "type": "integer",
      "default": 4
    },
    "showExcerpt": {
      "type": "boolean",
      "default": true
    },
    "manualPosts": {
      "type": "array",
      "default": [
        {
          "postId": 0,
          "titleOverride": "",
          "excerptOverride": "",
          "imageId": 0,
          "imageUrl": "",
          "imageAlt": "",
          "ctaLabel": "",
          "statValue": "",
          "statLabel": ""
        },
        {
          "postId": 0,
          "titleOverride": "",
          "excerptOverride": "",
          "imageId": 0,
          "imageUrl": "",
          "imageAlt": "",
          "ctaLabel": "",
          "statValue": "",
          "statLabel": ""
        },
        {
          "postId": 0,
          "titleOverride": "",
          "excerptOverride": "",
          "imageId": 0,
          "imageUrl": "",
          "imageAlt": "",
          "ctaLabel": "",
          "statValue": "",
          "statLabel": ""
        }
      ]
    },
    "bgColor": {
      "type": "string",
      "default": "taupe",
      "enum": [
        "taupe",
        "deep-blue"
      ]
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}
