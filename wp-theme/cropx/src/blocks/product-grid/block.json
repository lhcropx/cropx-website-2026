{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cropx/product-grid",
  "version": "1.0.0",
  "title": "Product Grid",
  "category": "cropx-product",
  "icon": "grid-view",
  "description": "3-column product card grid with optional section header (eyebrow, heading, body) and white/taupe/deep-blue background.",
  "keywords": ["product", "grid", "hardware", "sensors", "cards", "software", "platform"],
  "supports": {
    "html": false,
    "align": false,
    "anchor": true
  },
  "attributes": {
    "eyebrow":     { "type": "string",  "default": "Our Products" },
    "heading":     { "type": "string",  "default": "Everything you need to manage your operation" },
    "body":        { "type": "string",  "default": "" },
    "showEyebrow": { "type": "boolean", "default": true },
    "bgColor":     { "type": "string",  "default": "white", "enum": ["white", "taupe", "deep-blue"] },
    "items": {
      "type": "array",
      "default": [
        {
          "name": "CropX Vertex 4",
          "description": "All-in-one smart soil sensor. Monitors moisture, temperature, and salinity at multiple depths simultaneously.",
          "url": "#",
          "photoId": 0, "photoUrl": "", "photoAlt": "",
          "photoFocalX": 0.5, "photoFocalY": 0.5, "photoZoom": 100,
          "overlayId": 0, "overlayUrl": "", "overlayType": "none", "overlayPadding": 0,
          "overlayH": 100, "overlayX": 0, "overlayCentered": false, "overlayAnchor": "center"
        },
        {
          "name": "CropX Evato 1",
          "description": "Actual evapotranspiration sensor. Measures real crop water use directly in the field.",
          "url": "#",
          "photoId": 0, "photoUrl": "", "photoAlt": "",
          "photoFocalX": 0.5, "photoFocalY": 0.5, "photoZoom": 100,
          "overlayId": 0, "overlayUrl": "", "overlayType": "card-bleed", "overlayPadding": 0,
          "overlayH": 100, "overlayX": 0, "overlayCentered": false, "overlayAnchor": "center"
        },
        {
          "name": "CropX Strato 1",
          "description": "All-in-one weather station. Captures temperature, humidity, wind, and solar radiation.",
          "url": "#",
          "photoId": 0, "photoUrl": "", "photoAlt": "",
          "photoFocalX": 0.5, "photoFocalY": 0.5, "photoZoom": 100,
          "overlayId": 0, "overlayUrl": "", "overlayType": "none", "overlayPadding": 0,
          "overlayH": 100, "overlayX": 0, "overlayCentered": false, "overlayAnchor": "center"
        }
      ]
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle":  "file:./index.css",
  "style":        "file:./style-index.css",
  "render":       "file:./render.php"
}
