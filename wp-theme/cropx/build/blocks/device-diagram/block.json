  "title": "Interactive Device Diagram",
  "category": "cropx-product",
  "icon": "smartphone",
  "description": "A phone in the center with 4–8 product cards radiating out to its left and right. On desktop, hovering (or keyboard-focusing) a product highlights its connector line and shows the software it feeds in a caption under the phone. On touch devices and narrow screens the phone sits on top with a swipeable product carousel below it. Each product card links to its own page.",
  "keywords": [
    "device",
    "diagram",
    "phone",
    "products",
    "hardware",
    "software",
    "platform",
    "interactive",
    "ecosystem"
  ],
