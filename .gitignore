# Deployment patch zips + their extracted scratch folders (not source of truth)
*-patch.zip
*-patch-*.zip
*-patch/
*-patch-*/
*-fix.zip
*-fix-*.zip
*-fix/
*-fix-*/

# Scratch working folders left over from packaging patches (repo-root only —
# these mirror block/theme folder names but live at the root, not under
# wp-theme/cropx/, so anchor with a leading slash to avoid shadowing real
# tracked source directories of the same name)
/cards/
/faq-accordion/
/resource-downloads/
/inc/
/inc [0-9]*/
/build/
/product-sections/
/two-column-overlay/

# Office temp/lock files
~$*.docx
~$*.xlsx
*.docx

# OS cruft
.DS_Store

# wp-content-named duplicate folders (macOS/cloud-sync conflict copies,
# and stray copies of the real theme one level up from wp-theme/cropx/ —
# see PROGRESS.md / process_log.md §6a for the incident that created these)
/wp-content/
/wp-content [0-9]*/
/wp-theme/wp-content/
/wp-theme/wp-content [0-9]*/
/wp-theme/inc/
/wp-theme/inc [0-9]*/

# Deploy/revert zip pairs and their scratch extraction folders
# (never the source of truth — see CLAUDE.md "Deploying to live staging")
*-deploy.zip
*-deploy-*.zip
*-deploy/
*-deploy-*/
*-revert.zip
*-revert-*.zip
*-revert/
*-revert-*/

# One-off report/audit deliverables (generated point-in-time reports,
# not project source — regenerate from live data if ever needed again)
*-risk-report*.md
*-risk-report*.xlsx
*-risk-report*.csv
*-risk-urls*.csv
*-risk-urls*.xlsx
*-Comparison-Report.xlsx
*-Crawl-Report.xlsx
