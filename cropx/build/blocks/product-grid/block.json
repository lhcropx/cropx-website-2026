{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cropx/product-grid",
  "version": "0.1.0",
  "title": "Product Grid – ARCHIVED",
  "category": "cropx-product",
  "icon": "grid-view",
  "description": "3-column card grid with right-side photos bleeding flush to card edges. Equal-height rows. Optional illustration overlays (card-bleed or contained). Responsive: 2-col at 1080 px, 1-col at 700 px.",
  "keywords": [
    "product",
    "grid",
    "hardware",
    "sensors",
    "cards"
  ],
  "supports": {
    "html": false,
    "align": false,
    "anchor": true,
    "inserter": false
  },
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "CropX Hardware"
    },
    "eyebrowColor": {
      "type": "string",
      "default": "cropx-blue"
    },
    "heading": {
      "type": "string",
      "default": "The sensors behind the data"
    },
    "blurb": {
      "type": "string",
      "default": ""
    },
    "showHeader": {
      "type": "boolean",
      "default": true
    },
    "bgColor": {
      "type": "string",
      "default": "white",
      "enum": [
        "taupe",
        "white"
      ]
    },
    "items": {
      "type": "array",
      "default": [
        {
          "name": "CropX Vertex 4",
          "description": "All-in-one smart soil sensor. Monitors moisture, temperature, and salinity at multiple depths simultaneously.",
          "url": "#",
          "photoId": 0,
          "photoUrl": "",
          "photoAlt": "",
          "photoFocalX": 0.5,
          "photoFocalY": 0.5,
          "photoZoom": 100,
          "overlayId": 0,
          "overlayUrl": "",
          "overlayType": "none",
          "overlayPadding": 0,
          "overlayH": 100,
          "overlayX": 0,
          "overlayCentered": false,
          "overlayAnchor": "center"
        },
        {
          "name": "CropX Evato 1",
          "description": "Actual evapotranspiration sensor. Measures real crop water use directly in the field.",
          "url": "#",
          "photoId": 0,
          "photoUrl": "",
          "photoAlt": "",
          "photoFocalX": 0.5,
          "photoFocalY": 0.5,
          "photoZoom": 100,
          "overlayId": 0,
          "overlayUrl": "",
          "overlayType": "card-bleed",
          "overlayPadding": 0,
          "overlayH": 100,
          "overlayX": 0,
          "overlayCentered": false,
          "overlayAnchor": "center"
        },
        {
          "name": "CropX Strato 1",
          "description": "All-in-one weather station. Captures temperature, humidity, wind, and solar radiation.",
          "url": "#",
          "photoId": 0,
          "photoUrl": "",
          "photoAlt": "",
          "photoFocalX": 0.5,
          "photoFocalY": 0.5,
          "photoZoom": 100,
          "overlayId": 0,
          "overlayUrl": "",
          "overlayType": "none",
          "overlayPadding": 0,
          "overlayH": 100,
          "overlayX": 0,
          "overlayCentered": false,
          "overlayAnchor": "center"
        }
      ]
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}