{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cropx/testimonial-single",
  "version": "0.1.0",
  "title": "Testimonial (Full-Width Single)",
  "category": "cropx-social-proof",
  "icon": "format-quote",
  "description": "Big-quote spotlight. Centered quote with curly-quote pseudo-elements, attribution row (3.5rem square photo or logo + name + title/company). Two background variants: white and Deep Blue with animated drift pattern.",
  "keywords": [
    "testimonial",
    "quote",
    "customer",
    "review"
  ],
  "supports": {
    "html": false,
    "align": false
  },
  "attributes": {
    "backgroundVariant": {
      "type": "string",
      "default": "taupe",
      "enum": [
        "taupe",
        "white",
        "blue"
      ]
    },
    "quote": {
      "type": "string",
      "default": ""
    },
    "authorName": {
      "type": "string",
      "default": ""
    },
    "authorTitle": {
      "type": "string",
      "default": ""
    },
    "authorCompany": {
      "type": "string",
      "default": ""
    },
    "showPhoto": {
      "type": "boolean",
      "default": true
    },
    "photoId": {
      "type": "number",
      "default": 0
    },
    "photoUrl": {
      "type": "string",
      "default": ""
    },
    "photoAlt": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}