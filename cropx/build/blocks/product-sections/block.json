{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cropx/product-sections",
  "version": "1.0.0",
  "title": "Product Grid with Tabs",
  "category": "cropx-product",
  "icon": "align-wide",
  "description": "Two stacked product grids (CropX Platform / CropX Hardware) with a sticky scroll-aware jump nav. Both sections are always visible — the nav highlights which one is in view.",
  "keywords": [
    "products",
    "sections",
    "scroll",
    "jump nav",
    "hardware",
    "platform",
    "grid"
  ],
  "supports": {
    "html": false,
    "align": false,
    "anchor": true
  },
  "attributes": {
    "platformLabel": {
      "type": "string",
      "default": "CropX Platform"
    },
    "hardwareLabel": {
      "type": "string",
      "default": "CropX Hardware"
    },
    "platformEyebrow": {
      "type": "string",
      "default": "Digital Agronomy"
    },
    "platformHeading": {
      "type": "string",
      "default": "CropX Platform"
    },
    "platformBlurb": {
      "type": "string",
      "default": ""
    },
    "hardwareEyebrow": {
      "type": "string",
      "default": "Field-Ready Devices"
    },
    "hardwareHeading": {
      "type": "string",
      "default": "CropX Hardware"
    },
    "hardwareBlurb": {
      "type": "string",
      "default": ""
    },
    "bgColor": {
      "type": "string",
      "default": "white",
      "enum": [
        "taupe",
        "white"
      ]
    },
    "platformItems": {
      "type": "array",
      "default": [
        {
          "name": "Farm Management",
          "description": "End-to-end planning and irrigation scheduling on one platform.",
          "url": "#",
          "photoId": 0,
          "photoUrl": "",
          "photoAlt": "",
          "photoFocalX": 0.5,
          "photoFocalY": 0.5,
          "photoZoom": 100,
          "overlayId": 0,
          "overlayUrl": "",
          "overlayType": "none",
          "overlayPadding": 0,
          "overlayH": 100,
          "overlayX": 0,
          "overlayCentered": false,
          "overlayAnchor": "center"
        }
      ]
    },
    "hardwareItems": {
      "type": "array",
      "default": [
        {
          "name": "CropX Vertex 4",
          "description": "All-in-one smart soil sensor. Monitors moisture, temperature, and salinity at multiple depths.",
          "url": "#",
          "photoId": 0,
          "photoUrl": "",
          "photoAlt": "",
          "photoFocalX": 0.5,
          "photoFocalY": 0.5,
          "photoZoom": 100,
          "overlayId": 0,
          "overlayUrl": "",
          "overlayType": "none",
          "overlayPadding": 0,
          "overlayH": 100,
          "overlayX": 0,
          "overlayCentered": false,
          "overlayAnchor": "center"
        }
      ]
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}