{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cropx/hero-blog",
  "version": "0.1.0",
  "title": "Blog Hero — Curved Edge",
  "category": "cropx-hero",
  "icon": "admin-post",
  "description": "Full-bleed curved-bottom hero for blog and publications archive pages. Renders live category filter pills in place of a CTA button.",
  "keywords": ["hero", "curved", "blog", "archive", "swoop", "category", "filter"],
  "supports": {
    "html": false,
    "align": false,
    "anchor": true
  },
  "attributes": {
    "segment": {
      "type": "string",
      "default": "cropx",
      "enum": ["cropx", "enterprise", "service-provider", "on-farm"]
    },
    "eyebrow":    { "type": "string", "default": "Field Notes" },
    "heading":    { "type": "string", "default": "Insights for the <em>Modern Agronomist</em>" },
    "subheading": {
      "type": "string",
      "default": "Real-world science, data-driven thinking, and practical guidance for agronomists navigating a rapidly changing field."
    },
    "bgImageId":  { "type": "number", "default": 0 },
    "bgImageUrl": { "type": "string", "default": "" },
    "bgFocalX":   { "type": "number", "default": 0.5 },
    "bgFocalY":   { "type": "number", "default": 0.3 },
    "bgZoom":     { "type": "number", "default": 100 },
    "deviceImageId":  { "type": "number", "default": 0 },
    "deviceImageUrl": { "type": "string", "default": "" },
    "phoneImageId":   { "type": "number", "default": 0 },
    "phoneImageUrl":  { "type": "string", "default": "" },
    "showEyebrow":     { "type": "boolean", "default": true },
    "showDeviceImage": { "type": "boolean", "default": false },
    "showAppImage":    { "type": "boolean", "default": false },
    "deviceScale":   { "type": "number", "default": 100 },
    "deviceOffsetX": { "type": "number", "default": 0 },
    "deviceOffsetY": { "type": "number", "default": 0 },
    "phoneScale":    { "type": "number", "default": 100 },
    "phoneOffsetX":  { "type": "number", "default": 0 },
    "phoneOffsetY":  { "type": "number", "default": 0 },
    "swoopFill":     { "type": "string", "default": "" }
  },
  "editorScript": "file:./index.js",
  "editorStyle":  "file:./index.css",
  "style":        "file:./style-index.css",
  "viewScript":   "file:./view.js",
  "render":       "file:./render.php"
}
